# Server Configuration
PORT=4000
NODE_ENV=development

# Neon Serverless PostgreSQL (https://neon.tech)
DATABASE_URL="postgresql://user:pass@ep-cool-darkness-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication (JWT)
JWT_SECRET="super-secret-jwt-key-change-in-production"

# Cloudflare R2 Object Storage (S3-Compatible)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="aether-3d-assets"
R2_PUBLIC_CDN_URL="https://cdn.aetherfootwear.com"

# Frontend Integration & On-Demand ISR Webhook
FRONTEND_URL="http://localhost:3000,https://atelier-vance-storefront.vercel.app"
REVALIDATE_SECRET="isr-revalidate-webhook-secret-token"

