generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EDITOR
  CUSTOMER
}

enum SectionType {
  HERO_CONFIG
  STATEMENT_BANNER
  FAQ_LIST
  NEWSLETTER
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id              String            @id @default(cuid())
  slug            String            @unique
  name            String
  tagline         String
  description     String
  richStoryHtml   String
  basePrice       Float
  category        String
  collectionSlug  String            @default("cyber-runner")
  isFeaturedHero  Boolean           @default(false)
  displayOrder    Int               @default(0)
  published       Boolean           @default(true)
  metaTitle       String
  metaDescription String
  ogImageUrl      String
  keywords        String[]
  specsJson       Json?
  ratingValue     Float             @default(4.9)
  reviewCount     Int               @default(42)
  variants        ColorwayVariant[]
  hotspots        ScrollHotspot[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([published, displayOrder])
  @@index([category])
  @@index([collectionSlug])
}

model ColorwayVariant {
  id                 String          @id @default(cuid())
  productId          String
  product            Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorName          String
  skuPrefix          String
  primaryGlowHex     String
  secondaryAccentHex String
  glbModelUrl        String
  posterImageUrl     String
  galleryImages      String[]
  altText            String
  sizes              SizeInventory[]
  orderItems         OrderItem[]

  @@index([productId])
}

model SizeInventory {
  id         String          @id @default(cuid())
  variantId  String
  variant    ColorwayVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sizeLabel  String
  sku        String          @unique
  stockCount Int             @default(0)

  @@index([variantId])
}

model ScrollHotspot {
  id               String  @id @default(cuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  scrollPercentage Float
  title            String
  subtitle         String
  cameraPosition   Json
  cameraTarget     Json

  @@index([productId, scrollPercentage])
}

model PageSection {
  id          String      @id @default(cuid())
  pageSlug    String
  sectionType SectionType
  contentJson Json
  orderIndex  Int         @default(0)
  isVisible   Boolean     @default(true)
  updatedAt   DateTime    @updatedAt

  @@index([pageSlug, orderIndex])
}

model SiteSeoConfig {
  id                     String   @id @default(cuid())
  siteName               String
  siteUrl                String
  defaultMetaTitle       String
  defaultMetaDescription String
  defaultOgImage         String
  organizationSchemaJson Json
  updatedAt              DateTime @updatedAt
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  status                OrderStatus @default(PENDING)
  customerEmail         String
  customerName          String
  shippingAddressJson   Json
  subtotal              Float
  totalAmount           Float
  stripePaymentIntentId String?     @unique
  items                 OrderItem[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([status, createdAt])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ColorwayVariant @relation(fields: [variantId], references: [id])
  sizeSku   String
  sizeLabel String
  quantity  Int
  unitPrice Float

  @@index([orderId])
}

